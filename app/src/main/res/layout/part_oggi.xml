<?xml version="1.0" encoding="utf-8"?>
<!-- La scheda in cima: quante domande scadono oggi, quanto e' assodato in tutto,
     e il pulsante che fa partire il ripasso senza scegliere nulla. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/oggi_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp"
    app:contentPadding="20dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/oggi_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:letterSpacing="0.05"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/oggi_titolo"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.02"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/oggi_sotto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/oggi_vai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/ripassa_adesso" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/oggi_esame"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prova_esame" />
            </LinearLayout>
        </LinearLayout>

        <com.marco.lanquiz.RingView
            android:id="@+id/oggi_ring"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="16dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
