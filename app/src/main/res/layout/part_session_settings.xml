<?xml version="1.0" encoding="utf-8"?>
<!-- Le impostazioni della sessione: valgono per il prossimo quiz avviato,
     qualunque sia il banco scelto. Incluse sia nel layout telefono sia in quello
     tablet, così esistono in una sola copia. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="16dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/impostazioni_sessione"
            android:textColor="@color/indigo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/modalita"
            android:textColor="@color/muted" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_studio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/modalita_studio" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_esame"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modalita_esame" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/mode_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/numero_domande"
            android:textColor="@color/muted" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tutte" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_10"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_25"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_50"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prova_esame" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_count_custom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizza" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/timer_label"
            android:textColor="@color/muted" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_t0"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/senza_timer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_t15"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_t30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_t90"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_timer_custom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizza" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_shuffle_q"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/mescola_domande" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_shuffle_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/mescola_risposte" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
