<?xml version="1.0" encoding="utf-8"?>
<!-- Controlli a segmenti: un gruppo unico per ogni scelta, non pastiglie sparse.
     Valgono per il prossimo quiz avviato, qualunque banco si scelga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Etichetta.Sezione"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/come_esercitarsi" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/group_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_studio"
            style="@style/Segmento"
            android:text="@string/modalita_studio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_esame"
            style="@style/Segmento"
            android:text="@string/modalita_esame" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/mode_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        style="@style/Etichetta.Sezione"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/numero_domande" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/group_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_all"
            style="@style/Segmento"
            android:text="@string/tutte" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_10"
            style="@style/Segmento"
            android:text="@string/dieci" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_25"
            style="@style/Segmento"
            android:text="@string/venticinque" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_50"
            style="@style/Segmento"
            android:text="@string/cinquanta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_count_custom"
            style="@style/Segmento"
            android:text="@string/personalizza" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/Etichetta.Sezione"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/timer_label" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/group_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_t0"
            style="@style/Segmento"
            android:text="@string/senza_timer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_t15"
            style="@style/Segmento"
            android:text="@string/quindici_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_t30"
            style="@style/Segmento"
            android:text="@string/trenta_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_t90"
            style="@style/Segmento"
            android:text="@string/novanta_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chip_timer_custom"
            style="@style/Segmento"
            android:text="@string/personalizza" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_shuffle_q"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:checked="true"
        android:text="@string/mescola_domande" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_shuffle_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="@string/mescola_risposte" />
</LinearLayout>
