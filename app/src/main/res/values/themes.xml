<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema DayNight: segue il sistema, ma l'utente puo forzarlo da Impostazioni. -->
    <style name="Theme.LanQuiz" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/ko</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Angoli piu ampi: e' meta della personalita di questa direzione. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.LanQuiz.XS</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.LanQuiz.S</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.LanQuiz.M</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.LanQuiz.L</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.LanQuiz.XL</item>
    </style>

    <style name="Shape.LanQuiz.XS" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">11dp</item>
    </style>
    <style name="Shape.LanQuiz.S" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Shape.LanQuiz.M" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>
    <style name="Shape.LanQuiz.L" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">22dp</item>
    </style>
    <style name="Shape.LanQuiz.XL" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">26dp</item>
    </style>

    <!-- Bricolage Grotesque solo dove serve carattere: titoli e numeri grandi.
         Il testo corrente resta nel font di sistema, che si legge meglio. -->
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/bricolage_extrabold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.Titolo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/bricolage_extrabold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Etichetta sopra un gruppo di controlli. -->
    <style name="Etichetta.Sezione" parent="">
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Un segmento dentro un MaterialButtonToggleGroup: cinque devono starci
         in larghezza su un telefono, quindi niente margini laterali. -->
    <style name="Segmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
